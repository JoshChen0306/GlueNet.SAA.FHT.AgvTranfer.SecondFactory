    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model pUser
<div class="col-lg-12 main-chart">
    <div class="col-6">
        <div class="d-flex">
            <h4 class="mt-3 mb-3 "><strong>帳號管理</strong></h4>
            <div class="ms-auto">
                <button class="mt-3 btn btn-outline-primary" id="maintain-btn"><i class="fa-solid fa-pen-to-square me-1"></i>維護</button>
                <button class="mt-3 btn btn-success d-none" id="maintain-save"><i class="fa-solid fa-floppy-disk me-1"></i>儲存</button>
                <button class="mt-3 btn btn-outline-secondary d-none" id="maintain-cancel"><i class="fa-solid fa-xmark me-1"></i>取消</button>
            </div>
        </div>
        <div class="bg-white p-3">
            <div class="row">
                <div class="col-3 d-flex justify-content-center align-items-center">
                    <i class="fa-solid fa-user fa-4x" style="color:#9A9A9A"></i>
                </div>
                <div class="col-9">
                    <form>
                        <div class="row gy-3">
                            <div class="d-flex align-items-center">
                                <label class="text-secondary me-5">工號</label>
                                <input class="form-control-plaintext p-1 w-50" name="UserId" value="@Model.UserId" readonly />
                            </div>
                            <div class="d-flex align-items-center">
                                <label class="text-secondary me-3">中文名稱</label>
                                <input class="form-control-plaintext p-1 w-50" name="UserName" value="@Model.UserName" autocomplete="off" readonly />
                            </div>
                            <div class="d-flex align-items-center">
                                <label class="text-secondary me-5">密碼</label>
                                <input class="form-control-plaintext p-1 w-50" name="Password" value="@Model.Password" autocomplete="off" type="password" readonly />
                            </div>
                            <div class="d-flex align-items-center">
                                <label class="text-secondary me-3">電子郵件</label>
                                <input class="form-control-plaintext p-1 w-50" name="Mail" value="@Model.Mail" autocomplete="off" readonly />
                            </div>
                            <div class="d-flex align-items-center">
                                <label class="text-secondary me-5">電話</label>
                                <input class="form-control-plaintext p-1 w-50" name="Tel" value="@Model.Tel" autocomplete="off" readonly />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/account.js"></script>
}