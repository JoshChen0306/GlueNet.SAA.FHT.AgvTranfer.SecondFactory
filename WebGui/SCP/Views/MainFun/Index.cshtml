    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model IEnumerable<pFunction>
<div class="col-lg-12 main-chart">
    <div class="col-12">
        <div class="d-flex">
            <h4 class="mt-3 mb-3 "><strong>程式功能維護</strong></h4>
            <div class="ms-auto">
                <button class="mt-3 btn btn-outline-primary" id="maintain-btn"><i class="fa-solid fa-pen-to-square me-1"></i>維護</button>
                <button class="mt-3 btn btn-success d-none" id="maintain-save"><i class="fa-solid fa-floppy-disk me-1"></i>儲存</button>
                <button class="mt-3 btn btn-outline-secondary d-none" id="maintain-cancel"><i class="fa-solid fa-xmark me-1"></i>取消</button>
            </div>
        </div>
        <div class="bg-white maintain-table maintain-table-large">
            <table class="table mt-4" id="maintain-table">
                <thead class="text-center ">
                    <tr>
                        <th class="text-secondary">#</th>
                        <th class="text-secondary">主項編號</th>
                        <th class="text-secondary">次項編號</th>
                        <th class="text-secondary">功能編號</th>
                        <th class="text-secondary">功能類型</th>
                        <th class="text-secondary">功能中文名稱</th>
                        <th class="text-secondary">功能英文名稱</th>
                        <th class="text-secondary">控制旗標</th>
                        <th class="text-secondary">頁面網址</th>
                        <th class="text-secondary">頁面圖示</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr class="text-center">
                            <td class="align-middle">@i</td>
                            <td class="align-middle">@item.ColumnNo</td>
                            <td class="align-middle">@item.RowNo</td>
                            <td class="align-middle">@item.FunctionNo</td>
                            <td class="align-middle">@item.FunctionType</td>
                            <td class="align-middle">@item.FunctionChineseName</td>
                            <td class="align-middle">@item.FunctionEnglishName</td>
                            <td class="align-middle">@item.ControlFlag</td>
                            <td class="align-middle">@item.WebUrl</td>
                            <td class="align-middle">@item.WebIcon</td>
                            <td class="align-middle text-nowrap">
                                <button data-bs-toggle="collapse" data-bs-target="#edit-@item.FunctionNo" aria-expanded="false" aria-controls="@item.FunctionNo" class="btn edit-btn p-0">
                                    <i class="fa-solid fa-square-pen fa-xl" style="color: #40B1FF;"></i>
                                </button>
                                <button class="btn delete-btn p-0" id="delete-@item.FunctionNo"><i class="fa-solid fa-square-minus fa-xl" style="color: #E25E3E;"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="10" class="border-0 p-0">
                                <div id="edit-@item.FunctionNo" class="collapse ps-3 ">
                                    <form>
                                        <div class="row row-cols-3 gy-3 mb-3 m-0">
                                            <div class="col d-flex align-items-center">
                                                <label class="me-3">主項編號</label>
                                                <input class="form-control p-1 w-50" name="ColumnNo" value="@item.ColumnNo" />
                                            </div>
                                            <div class="col d-flex align-items-center">
                                                <label class="me-5">次項編號</label>
                                                <input class="form-control p-1 w-50" name="RowNo" autocomplete="off" value="@item.RowNo" />
                                            </div>
                                            <div class="col d-flex align-items-center">
                                                <label class="me-5">功能編號</label>
                                                <input class="form-control p-1 w-50" name="FunctionNo" autocomplete="off" value="@item.FunctionNo" />
                                            </div>
                                            <div class="col d-flex align-items-center">
                                                <label class="me-3">功能類型</label>
                                                <input class="form-control p-1 w-50" name="FunctionType" autocomplete="off" value="@item.FunctionType" />
                                            </div>
                                            <div class="col d-flex align-items-center">
                                                <label class="me-3">功能中文名稱</label>
                                                <input class="form-control p-1 w-50" name="FunctionChineseName" autocomplete="off" value="@item.FunctionChineseName" />
                                            </div>
                                            <div class="col d-flex align-items-center">
                                                <label class="me-3">功能英文名稱</label>
                                                <input class="form-control p-1 w-50" name="FunctionEnglishName" autocomplete="off" value="@item.FunctionEnglishName" />
                                            </div>
                                            <div class="col d-flex align-items-center">
                                                <label class="me-3">控制旗標</label>
                                                <input class="form-control p-1 w-50" name="ControlFlag" autocomplete="off" value="@item.ControlFlag" />
                                            </div>
                                            <div class="col d-flex align-items-center">
                                                <label class="me-5">頁面網址</label>
                                                <input class="form-control p-1 w-50" name="WebUrl" autocomplete="off" value="@item.WebUrl" />
                                            </div>
                                            <div class="col d-flex align-items-center">
                                                <label class="me-5">頁面圖示</label>
                                                <input class="form-control p-1 w-50" name="WebIcon" autocomplete="off" value="@item.WebIcon" />
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
                <tfoot>
                    <tr data-bs-toggle="collapse" data-bs-target="#insertcollapse" id="InsertData">
                        <td colspan="10" id="insert-btn" class="bg-secondary border-0 bg-opacity-10 text-center d-none" style="cursor: pointer;">
                            <i class="fa-solid fa-square-plus fa-xl" style="color: #9A9A9A;"></i>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="10" class="border-0 p-0">
                            <div id="insertcollapse" class="collapse ps-3">
                                <form id="InsertForm">
                                    <div class="row row-cols-3 gy-3 mb-3 m-0">
                                        <div class="col d-flex align-items-center">
                                            <label class="me-3" for="ColumnNo">主項編號</label>
                                            <input class="form-control p-1 w-50" name="ColumnNo" required />
                                        </div>
                                        <div class="col d-flex align-items-center">
                                            <label class="me-5" for="RowNo">次項編號</label>
                                            <input class="form-control p-1 w-50" name="RowNo" autocomplete="off" required />
                                        </div>
                                        <div class="col d-flex align-items-center">
                                            <label class="me-5" for="FunctionNo">功能編號</label>
                                            <input class="form-control p-1 w-50" name="FunctionNo" autocomplete="off" required />
                                        </div>
                                        <div class="col d-flex align-items-center">
                                            <label class="me-3">功能類型</label>
                                            <input class="form-control p-1 w-50" name="FunctionType" autocomplete="off"  />
                                        </div>
                                        <div class="col d-flex align-items-center">
                                            <label class="me-3">功能中文名稱</label>
                                            <input class="form-control p-1 w-50" name="FunctionChineseName" autocomplete="off"/>
                                        </div>
                                        <div class="col d-flex align-items-center">
                                            <label class="me-3">功能英文名稱</label>
                                            <input class="form-control p-1 w-50" name="FunctionEnglishName" autocomplete="off" />
                                        </div>
                                        <div class="col d-flex align-items-center">
                                            <label class="me-3">控制旗標</label>
                                            <input class="form-control p-1 w-50" name="ControlFlag" autocomplete="off"  />
                                        </div>
                                        <div class="col d-flex align-items-center">
                                            <label class="me-5">頁面網址</label>
                                            <input class="form-control p-1 w-50" name="WebUrl" autocomplete="off"  />
                                        </div>
                                        <div class="col d-flex align-items-center">
                                            <label class="me-5">頁面圖示</label>
                                            <input class="form-control p-1 w-50" name="WebIcon" autocomplete="off" />
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </td>
                        <td class="border-0 text-center ">
                            <button class="btn p-0" id="confirm-btn">
                                <i class="fa-solid fa-square-check fa-xl" style="color: #4CCD99;"></i>
                            </button>
                            <button class="btn  p-0" data-bs-toggle="collapse" data-bs-target="#insertcollapse" id="cancel-btn"><i class="fa-solid fa-square-minus fa-xl" style="color: #E25E3E;"></i></button>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section scripts{
    <script src="~/js/mainfun.js"></script>
}