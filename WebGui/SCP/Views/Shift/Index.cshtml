@{
}
@model IEnumerable<pShift>
<div class="col-lg-12 main-chart">
    <div class="col-6">
        <div class="d-flex">
            <h4 class="mt-3 mb-3"><strong>班別列表</strong></h4>
            <div class="ms-auto">
                <button class="mt-3 btn btn-outline-primary" id="maintain-btn"><i class="fa-solid fa-pen-to-square me-1"></i>維護</button>
                <button class="mt-3 btn btn-success d-none" id="maintain-save"><i class="fa-solid fa-floppy-disk me-1"></i>儲存</button>
                <button class="mt-3 btn btn-outline-secondary d-none" id="maintain-cancel"><i class="fa-solid fa-xmark me-1"></i>取消</button>
            </div>
        </div>
        <div class="maintain-table">
            <table class="table mt-4" id="maintain-table">
                <thead class="text-center ">
                    <tr>
                        <th class="text-secondary">班別代碼</th>
                        <th class="text-secondary">班別名稱</th>
                        <th class="text-secondary">起始時間</th>
                        <th class="text-secondary">結束時間</th>
                        <th class="text-secondary">生效日期</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody class="text-center">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle">@item.ShiftCode</td>
                            <td class="align-middle">@item.ShiftName</td>
                            <td class="align-middle">@item.BeginDateTime</td>
                            <td class="align-middle">@item.EndDateTime</td>
                            <td class="align-middle">@item.EffectDateTime</td>
                            <td class="align-middle">
                                <button data-bs-toggle="collapse" data-bs-target="#edit-@item.ShiftCode" aria-expanded="false" aria-controls="@item.ShiftCode" class="btn edit-btn p-0">
                                    <i class="fa-solid fa-square-pen fa-xl" style="color: #40B1FF;"></i>
                                </button>
                                <button class="btn delete-btn p-0" id="delete-@item.ShiftCode"><i class="fa-solid fa-square-minus fa-xl" style="color: #E25E3E;"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5" class="border-0 p-0">
                                <div id="edit-@item.ShiftCode" class="collapse ps-3">
                                    <form>
                                        <div class=" d-flex align-items-center mt-3 mb-3">
                                            <label class="me-3">班別代碼:</label>
                                            <input class="form-control-plaintext w-25" name="ShiftCode" readonly value="@item.ShiftCode" />
                                        </div>
                                        <div class=" d-flex align-items-center mb-3">
                                            <label class=" me-3">班別名稱:</label>
                                            <input class="form-control p-0 w-25" name="ShiftName" autocomplete="off" value="@item.ShiftName" />
                                        </div>
                                        <div class=" d-flex align-items-center mb-3">
                                            <label class=" me-3">起始時間:</label>
                                            <input type="time" name="BeginDateTime" value="@item.BeginDateTime" />
                                        </div>
                                        <div class=" d-flex align-items-center mb-3">
                                            <label class=" me-3">結束時間:</label>
                                            <input type="time" name="EndDateTime" value="@item.EndDateTime" />
                                        </div>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr data-bs-toggle="collapse" data-bs-target="#insertcollapse" id="InsertData">
                        <td colspan="5" id="insert-btn" class="bg-secondary border-0 bg-opacity-10 text-center d-none" style="cursor: pointer;">
                            <i class="fa-solid fa-square-plus fa-xl" style="color: #9A9A9A;"></i>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="5" class="border-0 p-0">
                            <div id="insertcollapse" class="collapse ps-3">
                                <form id="InsertForm">
                                    <div class=" d-flex align-items-center mt-3 mb-3">
                                        <label class="me-3">班別代碼:</label>
                                        <input class="form-control p-0 w-25" name="ShiftCode" required autocomplete="off" value="" />
                                    </div>
                                    <div class=" d-flex align-items-center mb-3">
                                        <label class=" me-3">班別名稱:</label>
                                        <input class="form-control p-0 w-25" name="ShiftName" autocomplete="off" value="" />
                                    </div>
                                    <div class=" d-flex align-items-center mb-3">
                                        <label class=" me-3">起始時間:</label>
                                        <input type="time" name="BeginDateTime" value="" />
                                    </div>
                                    <div class=" d-flex align-items-center mb-3">
                                        <label class=" me-3">結束時間:</label>
                                        <input type="time" name="EndDateTime" value="" />
                                    </div>
                                    <div class=" d-flex align-items-center mb-3">
                                        <label class=" me-3">生效日期:</label>
                                        <input type="date" name="EffectDateTime" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                    </div>
                                </form>
                            </div>
                        </td>
                        <td class="border-0 text-center ">
                            <button class="btn p-0" id="confirm-btn">
                                <i class="fa-solid fa-square-check fa-xl" style="color: #4CCD99;"></i>
                            </button>
                            <button class="btn  p-0" data-bs-toggle="collapse" data-bs-target="#insertcollapse" id="cancel-btn"><i class="fa-solid fa-square-minus fa-xl" style="color: #E25E3E;"></i></button>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/shift.js"></script>
}
