@{
}
@model IEnumerable<pUser>
<div class="col-lg-12 main-chart">
    <div class="col-7">
        <div class="d-flex">
            <h4 class="mt-3 mb-3"><strong>用戶列表</strong></h4>
            <div class="ms-auto">
                <button class="mt-3 btn btn-outline-primary" id="maintain-btn"><i class="fa-solid fa-pen-to-square me-1"></i>維護</button>
                <button class="mt-3 btn btn-success d-none" id="maintain-save"><i class="fa-solid fa-floppy-disk me-1"></i>儲存</button>
                <button class="mt-3 btn btn-outline-secondary d-none" id="maintain-cancel"><i class="fa-solid fa-xmark me-1"></i>取消</button>
            </div>
        </div>
        <div class="maintain-table">
            <table class="table mt-4" id="maintain-table">
                <thead class="text-center ">
                    <tr>
                        <th class="text-secondary">#</th>
                        <th class="text-secondary">員工編號</th>
                        <th class="text-secondary">人員名稱</th>
                        <th class="text-secondary">群組類別</th>
                        <th class="text-secondary">電子郵件</th>
                        <th class="text-secondary">連絡電話</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{int i = 1;}
                    @foreach (var item in Model)
                    {
                        <tr class="text-center">
                            <td class="align-middle">@i</td>
                            <td class="align-middle">@item.UserId</td>
                            <td class="align-middle">@item.UserName</td>
                            <td class="align-middle">@ViewBag.GroupName[item.GroupId]</td>
                            <td class="align-middle">@item.Mail</td>
                            <td class="align-middle">@item.Tel</td>
                            <td class="align-middle text-nowrap">
                                <button data-bs-toggle="collapse" data-bs-target="#edit-@item.UserId" aria-expanded="false" aria-controls="@item.UserId" class="btn edit-btn p-0">
                                    <i class="fa-solid fa-square-pen fa-xl" style="color: #40B1FF;"></i>
                                </button>
                                <button class="btn delete-btn p-0" id="delete-@item.UserId"><i class="fa-solid fa-square-minus fa-xl" style="color: #E25E3E;"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" class="border-0 p-0">
                                <div id="edit-@item.UserId" class="collapse ps-3 ">
                                    <form>
                                        <div class="row row-cols-2 gy-3 m-0">
                                            <div class="col d-flex align-items-center">
                                                <label class="me-3">員工編號</label>
                                                <input class="form-control-plaintext  w-25" name="UserId" readonly value="@item.UserId" />
                                            </div>
                                            <div class="col d-flex align-items-center">
                                                <label class="me-3">人員名稱</label>
                                                <input class="form-control p-0 w-25" name="UserName" autocomplete="off" value="@item.UserName" />
                                            </div>
                                            <div class="col d-flex align-items-center">
                                                <label class="me-3">群組類別</label>
                                                @Html.DropDownList("GroupId",
                                                         new SelectList(ViewBag.GroupName, "Key", "Value", item.GroupId),
                                                         new { @class = "form-select p-0 w-50" })
                                            </div>
                                            <div class="col d-flex align-items-center">
                                                <label class="me-3">電子郵件</label>
                                                <input class="form-control p-0 w-75" name="Mail" autocomplete="off" value="@item.Mail" />
                                            </div>
                                            <div class="col d-flex align-items-center">
                                                <label class="me-3">連絡電話</label>
                                                <input class="form-control p-0 w-50" name="Tel" autocomplete="off" value="@item.Tel" />
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
                <tfoot>
                    <tr data-bs-toggle="collapse" data-bs-target="#insertcollapse" id="InsertData">
                        <td colspan="6" id="insert-btn" class="bg-secondary border-0 bg-opacity-10 text-center d-none" style="cursor: pointer;">
                            <i class="fa-solid fa-square-plus fa-xl" style="color: #9A9A9A;"></i>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" class="border-0 p-0">
                            <div id="insertcollapse" class="collapse ps-3">
                                <form id="InsertForm">
                                    <div class="row row-cols-2 gy-3 m-0">
                                        <div class="col d-flex align-items-center">
                                            <label class="me-3">員工編號</label>
                                            <input class="form-control p-0 w-25" name="UserId" autocomplete="off" required  />
                                        </div>
                                        <div class="col d-flex align-items-center">
                                            <label class="me-3">人員名稱</label>
                                            <input class="form-control p-0 w-25" name="UserName" autocomplete="off" />
                                        </div>
                                        <div class="col d-flex align-items-center">
                                            <label class="me-3">群組類別</label>
                                            @Html.DropDownList("GroupId",
                                                     new SelectList(ViewBag.GroupName, "Key", "Value"),
                                                     new { @class = "form-select p-0 w-50" })
                                        </div>
                                        <div class="col d-flex align-items-center">
                                            <label class="me-3">電子郵件</label>
                                            <input class="form-control p-0 w-75" name="Mail" autocomplete="off" />
                                        </div>
                                        <div class="col d-flex align-items-center">
                                            <label class="me-3">連絡電話</label>
                                            <input class="form-control p-0 w-50" name="Tel" autocomplete="off" />
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </td>
                        <td class="border-0 text-center ">
                            <button class="btn p-0" id="confirm-btn">
                                <i class="fa-solid fa-square-check fa-xl" style="color: #4CCD99;"></i>
                            </button>
                            <button class="btn  p-0" data-bs-toggle="collapse" data-bs-target="#insertcollapse" id="cancel-btn"><i class="fa-solid fa-square-minus fa-xl" style="color: #E25E3E;"></i></button>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/User.js"></script>
}
