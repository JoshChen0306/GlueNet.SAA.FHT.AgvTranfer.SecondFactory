@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@


<div class="col-lg-12 main-chart">
    <h4><strong>@Localizer["Map"]</strong></h4>
    <div class="mb-4" id="Map"></div>
    <div class="row">
        <div class="col-5">
            <form id="DispatchForm">
                <h4><strong>@Localizer["Dispatch"]</strong></h4>
                <div class="row mb-3">
                    <label class="col-2 col-form-label">樓層</label>
                    <div class="col-10">
                        <select class="form-select w-75" name="Floor" id="Floor" required>
                            @if (ViewBag.FloorList != null)
                            {
                                foreach (var item in (IEnumerable<SelectListItem>)ViewBag.FloorList)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-2 col-form-label">@Localizer["Area"]</label>
                    <div class="col-10">
                        <select class="form-select w-75" name="Area" id="Area" asp-items=@ViewBag.AreaList required disabled>
                            <option value="" class="text-secondary" disabled selected hidden>@Localizer["AreaText"]</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-2 col-form-label">@Localizer["BeginStation"]</label>
                    <div class="col-10">
                        <select class="form-select w-75 Site" name="BegingStation" id="BeginStation" asp-items=@ViewBag.Site required>
                            <option value="" disabled selected hidden>@Localizer["StationText"]</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-2 col-form-label">@Localizer["EndStation"]</label>
                    <div class="col-10">
                        <select class="form-select w-75 Site" name="EndStation" id="EndStation" asp-items=@ViewBag.Site required>
                            <option value="" disabled selected hidden>@Localizer["StationText"]</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-3" id="rackIdRow">
                    <label class="col-2 col-form-label">Rack碼</label>
                    <div class="col-10 d-flex align-items-center">
                        <input class="form-control me-3 w-75" id="RackId" name="RackId" placeholder="Rack編碼" readonly />
                    </div>
                </div>
                <div class="row position-relative mb-3" id="workOrderRow">
                    <label class="col-2 col-form-label">@Localizer["WorkOrder"]</label>
                    <div class="col-10 d-flex align-items-center">
                        <input class="form-control w-75 me-2" id="WorkOrder" name="WorkOrder" autocomplete="off" placeholder="@Localizer["BatchText"]" />
                        <button type="button" class="btn p-0 border-0 bg-transparent position-absolute"
                                style="right:22.5%;"
                                id="barcode-scan-btn">
                            <i class="fa-solid fa-qrcode fa-xl" style="color:gray;"></i>
                        </button>
                    </div>
                </div>
                @* 掃描機台 / 手動輸入機台（2F 專用） *@
                <div class="row position-relative mb-3" id="machineScanRow" style="display: none;">
                    <label class="col-2 col-form-label">機台號碼</label>
                    <div class="col-10 d-flex align-items-center">
                        <button type="button" class="btn btn-info rounded-pill me-2" id="machine-scan-btn">
                            <i class="fa-solid fa-qrcode me-1"></i>掃描機台
                        </button>
                        <button type="button" class="btn btn-outline-secondary rounded-pill" id="machine-manual-btn">
                            <i class="fa-solid fa-keyboard me-1"></i>手動輸入
                        </button>
                    </div>
                </div>
                <div class="row position-relative">
                    <label class="col-2 col-form-label"></label>
                    <div class="col-8 d-flex align-items-center justify-content-end">
                        @if (ViewBag.Role == "5")
                        {
                                <a class="btn btn-success rounded-pill me-4" id="UnloadButton" role="button">@Localizer["UnloadFinish"]</a>
                        }
                        else if (ViewBag.Role == "6" || ViewBag.Role == "1")
                        {
                                <a class="btn btn-primary rounded-pill me-3 ConfirmButton" id="ConfirmButton" role="button">@Localizer["Submit"]</a>
                                <a class="btn btn-secondary rounded-pill me-3 ConfirmButton" id="ChangeButton" role="button">@Localizer["Change"]</a>
                                <a class="btn btn-success rounded-pill me-4 ConfirmButton" id="RejectdButton" role="button">@Localizer["Reject"]</a>
                        }
                        else
                        {
                                <a class="btn btn-primary rounded-pill me-3 ConfirmButton" id="ConfirmButton" role="button">@Localizer["Submit"]</a>
                        }
                    </div>
                </div>
            </form>
        </div>
        <div class="col-7">
            <h4><strong>@Localizer["Tasks"]</strong></h4>
            <div class="maintain-table maintain-table-small">
                <table class="table mt-3">
                    <thead class="text-center">
                        <tr>
                            <th class="text-secondary">#</th>
                            <th class="text-secondary">@Localizer["BeginStation"]</th>
                            <th class="text-secondary">@Localizer["EndStation"]</th>
                            <th class="text-secondary">@Localizer["Batch"]</th>
                            <th class="text-secondary">任務類型</th>
                            <th class="text-secondary">@Localizer["Status"]</th>
                            <th class="text-secondary">@Localizer["Action"]</th>
                        </tr>
                    </thead>
                    <tbody class="text-center" id="DispatchStatus">
                        <Partial name="_DispatchPartial.cshtml"></Partial>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- html5-qrcode 優化的模態視窗 -->
    <div class="modal fade" id="barcodeModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fa-solid fa-qrcode me-2"></i>
                        條碼掃描器
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <div class="mb-3">
                        <p class="mb-2">支援 QR Code 和多種條碼格式</p>
                        <small class="text-muted">請將條碼對準掃描框中央</small>
                    </div>
    
                    <!-- html5-qrcode 掃描器容器 -->
                    <div id="qr-reader" style="width: 100%;"></div>
    
                    <div class="mt-3">
                        <small class="text-muted">
                            <i class="fa-solid fa-info-circle me-1"></i>
                            掃描成功後會自動填入工單欄位
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                     <button type="button" class="btn btn-secondary" id="barcode-scan-stop-btn">@Localizer["Close"]</button>
                </div>
            </div>
        </div>
    </div>



    @* Modal視窗 *@
    <div class="modal fade" id="dispatchModalToggle" aria-hidden="true" aria-labelledby="dispatchModalToggleLabel" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="dispatchModalToggleLabel"><strong>確認派車</strong></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    是否派送任務
                </div>
                <div class="modal-footer">
                    <button type="button" class="SubmitButton btn btn-primary rounded-pill">@Localizer["Submit"]</button>
                    <button type="button" class="btn btn-danger rounded-pill" data-bs-dismiss="modal">取消</button>
                </div>
            </div>
        </div>
    </div>
    @*下料完成*@
    <div class="modal fade" id="unloadModalToggle" aria-hidden="true" aria-labelledby="unloadModalToggleLabel" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="unloadModalToggleLabel"><strong>確認站點</strong></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    站點是否下料完成
                </div>
                <div class="modal-footer">
                    <button type="button" class="SubmitButton btn btn-primary rounded-pill">@Localizer["Submit"]</button>
                    <button type="button" class="btn btn-danger rounded-pill" data-bs-dismiss="modal">取消</button>
                </div>
            </div>
        </div>
    </div>
    @*退貨選擇*@
    <div class="modal fade" id="RejectModalToggle" aria-hidden="true" aria-labelledby="RejectModalToggleLabel" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="RejectModalToggleLabel"><strong>退貨選擇</strong></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="col-2 col-form-label">狀態選擇</label>
                    <div class="col-10">
                        <select class="form-select w-75 " name="Status" id="Status" required>
                            <option value="1">空盤</option>
                            <option value="3">料盤</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="SubmitButton btn btn-primary rounded-pill" data-bs-dismiss="modal">@Localizer["Submit"]</button>
                    <button type="button" class="btn btn-danger rounded-pill" data-bs-dismiss="modal">取消</button>
                </div>
            </div>
        </div>
    </div>
    @* 帳密驗證 *@
    <div class="modal fade" id="ReLoginModalToggle" aria-hidden="true" aria-labelledby="ReLoginModalToggleLabel" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ReLoginModalToggleLabel"><strong>帳號驗證</strong></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="col-10">
                        <div class="row mb-3">
                            <label class="col-2 col-form-label">帳號:</label>
                            <div class="col-10 d-flex align-items-center">
                                <input class="form-control me-3 w-75" id="userId" name="userId" placeholder="帳號" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-2 col-form-label">密碼:</label>
                            <div class="col-10 d-flex align-items-center">
                                <input class="form-control me-3 w-75" type="password" id="password" name="password" placeholder="密碼" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary rounded-pill" id="reLoginButton" data-bs-dismiss="modal">@Localizer["Submit"]</button>
                    <button type="button" class="btn btn-danger rounded-pill" data-bs-dismiss="modal">取消</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="dispatchModalToggle2" aria-hidden="true" aria-labelledby="dispatchModalToggleLabel2" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="dispatchModalToggleLabel2"><strong>確認派車</strong></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    派送成功
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                </div>
            </div>
        </div>
    </div>
    @* 取消任務 *@
    <div class="modal fade" id="cancleModal" aria-hidden="true" aria-labelledby="cancleModalToggleLabel" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="cancleModalToggleLabel"><strong>取消任務</strong></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    確認取消任務
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary rounded-pill" id="CancleButton">@Localizer["Submit"]</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
                </div>
            </div>
        </div>
    </div>
    @* 站點物料操作 Modal (M區/T區) *@
    <div class="modal fade" id="stationLotModal" aria-hidden="true" aria-labelledby="stationLotModalLabel" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="stationLotModalLabel"><strong>📍 <span id="stationLotName">M1</span> 站點操作</strong></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @* 站點狀態資訊 *@
                    <div class="mb-3 p-3 bg-light rounded">
                        <div class="row">
                            <div class="col-4"><strong>目前狀態：</strong></div>
                            <div class="col-8"><span id="stationLotStatus">空架</span></div>
                        </div>
                        <div class="row">
                            <div class="col-4"><strong>工單：</strong></div>
                            <div class="col-8"><span id="stationLotCurrentWorkOrder">無</span></div>
                        </div>
                        <div class="row">
                            <div class="col-4"><strong>貨架：</strong></div>
                            <div class="col-8"><span id="stationLotCurrentRackId">無</span></div>
                        </div>
                        <div class="row" id="vcutTagRow" style="display: none;">
                            <div class="col-4"><strong>🏷️ V Cut 專用：</strong></div>
                            <div class="col-8"><span id="stationLotVcutTag">否</span></div>
                        </div>
                    </div>
                    
                    @* 物料登記/修改表單 (動態顯示) *@
                    <div id="lotFormSection" class="d-none">
                        <hr />
                        <div class="mb-3">
                            <label class="form-label">工單條碼</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="registerLotWorkOrder" placeholder="工單條碼" />
                                <button type="button" class="btn btn-outline-secondary" id="scanWorkOrderBtn">
                                    <i class="fa-solid fa-qrcode"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-3" id="lotRackIdRow">
                            <label class="form-label">貨架條碼</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="registerLotRackId" placeholder="貨架條碼 (RackId)" />
                                <button type="button" class="btn btn-outline-secondary" id="scanRackIdBtn">
                                    <i class="fa-solid fa-qrcode"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-3" id="vcutCheckboxRow">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="registerLotVcut">
                                <label class="form-check-label" for="registerLotVcut">
                                    🏷️ V Cut 專用物料
                                </label>
                            </div>
                            <small class="text-muted">勾選後，此物料僅能派送至 V Cut 區</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" id="stationLotFooter">
                    @* 按鈕會由 JavaScript 動態生成 *@
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">關閉</button>
                </div>
            </div>
        </div>
    </div>
    
    @* 清除物料確認 Modal *@
    <div class="modal fade" id="clearLotConfirmModal" aria-hidden="true" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">⚠️ 確認清除</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <p>確定要清除 <strong id="clearLotStationName">M1</strong> 的物料資料嗎？</p>
                    <p class="text-muted small">此操作將清除工單和貨架資訊</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="button" class="btn btn-danger" id="confirmClearLotBtn">確認清除</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
        <script>
            // 樓層與區域對應 (從後端傳入) - 掛載到 window 供 ES module 存取
            window.floorAreaMap = @Html.Raw(Json.Serialize(ViewBag.FloorArea));
            // 使用者的路線權限 ID 清單（用於前端權限過濾）
            window.userRouteIds = @Html.Raw(Json.Serialize(ViewBag.UserRouteIds));
            // 使用者預設樓層（自動選擇第一個可用的樓層）
            window.defaultFloor = "@ViewBag.DefaultFloor";
            // 物料登記畫面是否顯示「貨架條碼」欄位（false 時前端隱藏欄位，送出固定帶 -1）
            window.showRackIdField = @(((bool?)ViewBag.ShowRackIdField ?? true) ? "true" : "false");
        </script>
        <script src="~/lib/html5-qrcode/html5-qrcode.min.js"></script>
        <script type="module" src="~/js/Map.js"></script>
        <script type="module" src="~/js/dispatch.js"></script>
}