@{

}
@{
    int i = 1;
    if (ViewBag.Dispatchs != null)
    {
        @foreach (var item in ViewBag.Dispatchs)
        {
            <tr data-taskdatetime="@item.TaskDateTime">
                <td class="align-middle">@i</td>
                <td class="align-middle">@item.BeginStation</td>
                <td class="align-middle">@item.EndStation</td>
                <td class="align-middle">@item.WorkOrder</td>
                <td class="align-middle">@item.TaskType</td>
                <td class="align-middle @item.TextColor">@item.Status</td>
                @if (ViewBag.Role =="1"){
                    <td class="align-middle"><button type="button" class="btn rounded-pill px-4 btn-secondary ConfirmCancle" data-bs-toggle="modal" data-bs-target="#cancleModal">取消</button></td>                 
                }
                else
                {
                     <td class="align-middle"><button class="btn rounded-pill px-4 btn-secondary" disabled>取消</button></td>
                }

            </tr>
            i++;
        }
    }
}