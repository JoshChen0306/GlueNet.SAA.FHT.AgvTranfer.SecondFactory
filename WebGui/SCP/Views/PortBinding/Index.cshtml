@{
}
@model IEnumerable<oPortBinding>
<div class="col-lg-12 main-chart">
    <div class="col-7">
        <div class="d-flex">
            <h4 class="mt-3 mb-3"><strong>上下料區綁定設定</strong></h4>
            <div class="ms-auto">
                <button class="mt-3 btn btn-outline-primary" id="maintain-btn"><i class="fa-solid fa-pen-to-square me-1"></i>維護</button>
                <button class="mt-3 btn btn-success d-none" id="maintain-save"><i class="fa-solid fa-floppy-disk me-1"></i>儲存</button>
                <button class="mt-3 btn btn-outline-secondary d-none" id="maintain-cancel"><i class="fa-solid fa-xmark me-1"></i>取消</button>
            </div>
        </div>
        <div class="maintain-table">
            <table class="table mt-4" id="maintain-table">
                <thead class="text-center">
                    <tr>
                        <th class="text-secondary">#</th>
                        <th class="text-secondary">上料區站點</th>
                        <th class="text-secondary">下料區站點</th>
                        <th class="text-secondary">回收候補區域</th>
                        <th class="text-secondary">啟用</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{int i = 1;}
                    @foreach (var item in Model)
                    {
                        <tr class="text-center">
                            <td class="align-middle">@i</td>
                            <td class="align-middle">@item.LoadingPort</td>
                            <td class="align-middle">@item.UnloadingPort</td>
                            <td class="align-middle">@item.FallbackAreas</td>
                            <td class="align-middle">
                                @if (item.UseFlag == "Y")
                                {
                                    <span class="badge bg-success">啟用</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">停用</span>
                                }
                            </td>
                            <td class="align-middle text-nowrap">
                                <button data-bs-toggle="collapse" data-bs-target="#edit-@item.LoadingPort" aria-expanded="false" aria-controls="@item.LoadingPort" class="btn edit-btn p-0">
                                    <i class="fa-solid fa-square-pen fa-xl" style="color: #40B1FF;"></i>
                                </button>
                                <button class="btn delete-btn p-0" id="delete-@item.LoadingPort"><i class="fa-solid fa-square-minus fa-xl" style="color: #E25E3E;"></i></button>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" class="border-0 p-0">
                                <div id="edit-@item.LoadingPort" class="collapse ps-3">
                                    <form>
                                        <div class="row row-cols-2 gy-3 m-0">
                                            <div class="col d-flex align-items-center">
                                                <label class="me-3">上料區站點</label>
                                                <input class="form-control-plaintext w-25" name="LoadingPort" readonly value="@item.LoadingPort" />
                                            </div>
                                            <div class="col d-flex align-items-center">
                                                <label class="me-3">下料區站點</label>
                                                <select class="form-select p-0 w-50" name="UnloadingPort">
                                                    @foreach (var station in ViewBag.StationList)
                                                    {
                                                        if (station == item.UnloadingPort)
                                                        {
                                                            <option value="@station" selected>@station</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@station">@station</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col d-flex align-items-center">
                                                <label class="me-3">回收候補區域</label>
                                                <input class="form-control p-0 w-50" name="FallbackAreas" autocomplete="off" value="@item.FallbackAreas" />
                                            </div>
                                            <div class="col d-flex align-items-center">
                                                <label class="me-3">啟用狀態</label>
                                                <select class="form-select p-0 w-25" name="UseFlag">
                                                    @if (item.UseFlag == "Y")
                                                    {
                                                        <option value="Y" selected>啟用</option>
                                                        <option value="N">停用</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="Y">啟用</option>
                                                        <option value="N" selected>停用</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
                <tfoot>
                    <tr data-bs-toggle="collapse" data-bs-target="#insertcollapse" id="InsertData">
                        <td colspan="6" id="insert-btn" class="bg-secondary border-0 bg-opacity-10 text-center d-none" style="cursor: pointer;">
                            <i class="fa-solid fa-square-plus fa-xl" style="color: #9A9A9A;"></i>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" class="border-0 p-0">
                            <div id="insertcollapse" class="collapse ps-3">
                                <form id="InsertForm">
                                    <div class="row row-cols-2 gy-3 m-0">
                                        <div class="col d-flex align-items-center">
                                            <label class="me-3">上料區站點</label>
                                            <select class="form-select p-0 w-50" name="LoadingPort" required>
                                                <option value="">請選擇</option>
                                                @foreach (var station in ViewBag.StationList)
                                                {
                                                    <option value="@station">@station</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col d-flex align-items-center">
                                            <label class="me-3">下料區站點</label>
                                            <select class="form-select p-0 w-50" name="UnloadingPort" required>
                                                <option value="">請選擇</option>
                                                @foreach (var station in ViewBag.StationList)
                                                {
                                                    <option value="@station">@station</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col d-flex align-items-center">
                                            <label class="me-3">回收候補區域</label>
                                            <input class="form-control p-0 w-50" name="FallbackAreas" autocomplete="off" placeholder="例: M,Q,R" />
                                        </div>
                                        <div class="col d-flex align-items-center">
                                            <label class="me-3">啟用狀態</label>
                                            <select class="form-select p-0 w-25" name="UseFlag">
                                                <option value="Y" selected>啟用</option>
                                                <option value="N">停用</option>
                                            </select>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </td>
                        <td class="border-0 text-center">
                            <button class="btn p-0" id="confirm-btn">
                                <i class="fa-solid fa-square-check fa-xl" style="color: #4CCD99;"></i>
                            </button>
                            <button class="btn p-0" data-bs-toggle="collapse" data-bs-target="#insertcollapse" id="cancel-btn"><i class="fa-solid fa-square-minus fa-xl" style="color: #E25E3E;"></i></button>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/PortBinding.js"></script>
}
