@{
    ViewData["Title"] = "Home Page";
}

@model pGroup

<div class="col-lg-12 main-chart">
    <h3 class="mt-3 mb-3 "><strong>群組功能維護</strong></h3>
    <div class="col-6 pt-3 mb-5">
        <div class="d-flex align-items-center">
            <label class="col-form-label me-3 text-secondary" for="staticEmail">群組代碼</label>
            <select asp-items=@ViewBag.GroupList class="form-select w-50" id="GroupName">
                <option value="">請選擇</option>
            </select>
        </div>
    </div>
    <div class="d-flex align-items-center">
        <div class="ms-auto">
            <button class="mt-3 btn btn-outline-primary invisible" id="maintain-btn"><i class="fa-solid fa-pen-to-square me-1"></i>維護</button>
            <button class="mt-3 btn btn-success d-none" id="maintain-save"><i class="fa-solid fa-floppy-disk me-1"></i>儲存</button>
            <button class="mt-3 btn btn-outline-secondary d-none" id="maintain-cancel"><i class="fa-solid fa-xmark me-1"></i>取消</button>
        </div>
    </div>
    <div class="bg-white p-3" id="pFunction">
        <partial name="_pFunctionPartialView.cshtml"></partial>
    </div>
    
</div>

@section Scripts {
    <script src="~/js/programgroup.js"></script>
}